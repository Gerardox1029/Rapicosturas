# Copia de referencia sin secretos. El .env local no se publica ni se versiona.
# En Netlify, configurar estas variables en el panel con alcance Functions.
# Nunca incluir secretos en dist/ ni en variables públicas de frontend.

APP_ORIGIN=
MONGODB_URI=
MONGODB_DB=rapicostura

# R2: credenciales S3 con acceso sólo al bucket de esta aplicación.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rapicosturas

# Mínimo 32 caracteres aleatorios. Sólo el servidor utiliza esta clave.
SESSION_SECRET=
# N inicial; sólo se utiliza al inicializar el acceso de dueña por primera vez.
# Después, cambiar desde Perfil > Cambiar patrón; no desde esta variable.
OWNER_INITIAL_PATTERN=7415963
# La evidencia se elimina 72 h después de confirmar recepción. No crear una
# regla global por antigüedad: borraría también tutoriales o envíos en camino.
